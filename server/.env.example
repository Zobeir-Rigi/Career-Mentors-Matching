# Environment variables for local development

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/mentor_matching

# Application
NODE_ENV=development

PORT=3000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=(`run this ```bash openssl rand -hex 32``` to generate your token`)
JWT_EXPIRES_IN=1d
AUTH_COOKIE_MAX_AGE_MS=86400000

EMAIL_PROVIDER=console
EMAIL_FROM="CYF Mentorship <mentorship@cyf.academy>"

# Deployment environment

# In production, configure NODE_ENV=production
# FRONTEND_URL=deployed-frontend-url
# JWT_SECRET=run```openssl rand -hex 32```to-generate-token
# JWT_EXPIRES_IN=1d
# AUTH_COOKIE_MAX_AGE_MS=86400000
# DATABASE_URL=production-postgres-url
# EMAIL_FROM="CYF Mentorship <mentorship@cyf.academy>"
# EMAIL_PROVIDER=ses
