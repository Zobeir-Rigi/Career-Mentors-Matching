generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

enum Role {
  MENTEE
  MENTOR
  ADMIN

  @@map("Roles")
}

enum Region {
  LONDON
  WEST_MIDLANDS
  SCOTLAND
  NORTH_WEST
  CAPE_TOWN
  SHEFFIELD
  OTHER

  @@map("Region")
}

enum AvailabilityOption {
  WEEKDAY_MORNING
  WEEKDAY_AFTERNOON
  WEEKDAY_EVENING
  WEEKEND_MORNING
  WEEKEND_AFTERNOON
  WEEKEND_EVENING

  @@map("AvailabilityOptions")
}

enum MeetingCadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY

  @@map("MeetingCadence")
}

enum MeetingStructure {
  OPEN
  STRUCTURED
  MIX

  @@map("MeetingStructure")
}

enum ApprovalStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("ApprovalStatus")
}

enum MatchStatus {
  CHEMISTRY_PENDING
  CHEMISTRY_CONFIRMED
  MATCH_PENDING
  ACTIVE
  COMPLETED
  DECLINED

  @@map("MatchStatus")
}

enum WaitingStatus {
  WAITING
  NOTIFIED
  MATCHED

  @@map("WaitingStatus")
}

model User {
  id                         String    @id @default(uuid()) @db.Uuid
  fullName                   String
  role                       Role
  email                      String    @unique
  passwordHashed             String
  linkedinURL                String?
  scheduleURL                String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  isActive                   Boolean   @default(true)
  deactivatedAt              DateTime?
  isEmailVerified            Boolean   @default(false)
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?

  passwordResetTokenHash     String?   @unique
  passwordResetExpiresAt     DateTime?

  menteeProfile  MenteeProfile?   @relation("UserMenteeProfile")
  mentorProfile  MentorProfile?   @relation("UserMentorProfile")
  matchingConfig MatchingConfig[]

  @@map("Users")
}

model MenteeProfile {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @unique @db.Uuid
  currentJobTitle  String?
  reasonsNote      String?
  region           Region?
  openToRemote     Boolean              @default(false)
  availability     AvailabilityOption[] @map("Availability")
  meetingCadence   MeetingCadence?
  meetingStructure MeetingStructure?
  bio              String?

  user User @relation("UserMenteeProfile", fields: [userId], references: [id], onDelete: Cascade)

  matches            Matches[]                  @relation("MenteeMatches")
  goalDisciplines    MenteeGoalDisciplines[]
  targetedIndustries MenteeTargetedIndustries[]
  waitingList        MenteeWaitingList?
  wantedSkills       MenteeWantedSkills[]

  @@map("MenteeProfile")
}

model MentorProfile {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @unique @db.Uuid
  currentJobTitle    String?
  capacity           Int                  @default(1)
  region             Region?
  openToRemote       Boolean              @default(false)
  availability       AvailabilityOption[] @map("Availability")
  meetingCadence     MeetingCadence?
  meetingStructure   MeetingStructure?
  bio                String?
  isAcceptingMentees Boolean              @default(false)
  approvalStatus     ApprovalStatus       @default(PENDING)
  notifiedAdminAt    DateTime?

  user User @relation("UserMentorProfile", fields: [userId], references: [id], onDelete: Cascade)

  matches                Matches[]                @relation("MentorMatches")
  mentorDisciplines      MentorDisciplines[]
  mentorDomainIndustries MentorDomainIndustries[]
  mentorSkills           MentorSkills[]

  @@map("MentorProfile")
}

model Skill {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String               @unique
  menteeWantedSkills MenteeWantedSkills[]
  mentorSkills       MentorSkills[]

  @@map("Skills")
}

model Discipline {
  id                    String                  @id @default(uuid()) @db.Uuid
  name                  String                  @unique
  menteeGoalDisciplines MenteeGoalDisciplines[]
  mentorDisciplines     MentorDisciplines[]

  @@map("Disciplines")
}

model Industry {
  id                       String                     @id @default(uuid()) @db.Uuid
  name                     String                     @unique
  menteeTargetedIndustries MenteeTargetedIndustries[]
  mentorDomainIndustries   MentorDomainIndustries[]

  @@map("Industries")
}

model MentorSkills {
  mentorId      String        @db.Uuid
  skillId       String        @db.Uuid
  mentorProfile MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([mentorId, skillId])
  @@map("MentorSkills")
}

model MentorDisciplines {
  mentorId      String        @db.Uuid
  disciplineId  String        @db.Uuid
  discipline    Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  mentorProfile MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@id([mentorId, disciplineId])
  @@map("MentorDisciplines")
}

model MentorDomainIndustries {
  mentorId      String        @db.Uuid
  industryId    String        @db.Uuid
  industry      Industry      @relation(fields: [industryId], references: [id], onDelete: Cascade)
  mentorProfile MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@id([mentorId, industryId])
  @@map("MentorDomainIndustries")
}

model MenteeWantedSkills {
  menteeId      String        @db.Uuid
  skillId       String        @db.Uuid
  menteeProfile MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([menteeId, skillId])
  @@map("MenteeWantedSkills")
}

model MenteeGoalDisciplines {
  menteeId      String        @db.Uuid
  disciplineId  String        @db.Uuid
  discipline    Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  menteeProfile MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  @@id([menteeId, disciplineId])
  @@map("MenteeGoalDisciplines")
}

model MenteeTargetedIndustries {
  menteeId      String        @db.Uuid
  industryId    String        @db.Uuid
  industry      Industry      @relation(fields: [industryId], references: [id], onDelete: Cascade)
  menteeProfile MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  @@id([menteeId, industryId])
  @@map("MenteeTargetIndustries")
}

model Matches {
  id                         String        @id @default(uuid()) @db.Uuid
  mentorId                   String        @db.Uuid
  menteeId                   String        @db.Uuid
  menteeSnapshot             Json          @db.Json
  mentorSnapshot             Json          @db.Json
  scores                     Float
  menteeAcceptedAt           DateTime?
  chemistryBookedAt          DateTime?
  chemistryMentorConfirmedAt DateTime?
  chemistryMenteeConfirmedAt DateTime?
  proposalExpiresAt          DateTime?
  scheduledCheckIn           DateTime?
  checkInExpiresAt           DateTime?
  checkInMenteeAgreed        Boolean?
  checkInMentorAgreed        Boolean?
  status                     MatchStatus   @default(CHEMISTRY_PENDING)
  createdAt                  DateTime      @default(now())
  completedAt                DateTime?
  declinedAt                 DateTime?
  menteeProfile              MenteeProfile @relation("MenteeMatches", fields: [menteeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mentorProfile              MentorProfile @relation("MentorMatches", fields: [mentorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mentorId, status])
  @@map("Matches")
}

model MatchingConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  weights            Json     @db.Json
  minScoreThreshold  Float
  isActive           Boolean
  createdAt          DateTime @default(now())
  updatedBy          String   @db.Uuid
  user               User     @relation(fields: [updatedBy], references: [id], onDelete: Cascade)

  @@map("MatchingConfig")
}

model MenteeWaitingList {
  id              String         @id @default(uuid()) @db.Uuid
  menteeId        String?        @unique @db.Uuid
  createdAt       DateTime       @default(now())
  notifiedAdminAt DateTime?
  status          WaitingStatus  @default(WAITING)
  menteeProfile   MenteeProfile? @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  @@map("MenteeWaitingList")
}
